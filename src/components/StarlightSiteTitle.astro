---
// Replaces Starlight's site title in the docs and blog header: the title, then, on blog pages only, the devlog's RSS
// feed (the site's only RSS link; the docs aren't the blog). On narrow screens, where Starlight hides the header's right-hand side, the Home, Blog and Docs
// links follow here instead (StarlightSocialIcons.astro shows them on wider screens), and the title text gives
// way to them.
import { Icon } from '@astrojs/starlight/components';
import Default from '@astrojs/starlight/components/SiteTitle.astro';
import SiteLinks from './SiteLinks.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isBlog = Astro.url.pathname.replace(base, '').startsWith('/blog');
---

<div class="title-row">
	<Default />
	{
		isBlog && (
			<a class="rss" href={`${base}/blog/rss.xml`} aria-label="Devlog RSS feed" title="Devlog RSS feed">
				<Icon name="rss" size="1.25rem" />
			</a>
		)
	}
	<div class="narrow-site-links">
		<SiteLinks />
	</div>
</div>

<style>
	.title-row {
		display: flex;
		align-items: center;
		gap: 1rem;
		min-width: 0;
	}
	.rss {
		display: flex;
		flex-shrink: 0;
		color: var(--sl-color-gray-1);
	}
	.rss:hover {
		color: var(--sl-color-accent);
	}
	.narrow-site-links {
		flex-shrink: 0;
	}
	/* Starlight shows the header's right-hand side (and StarlightSocialIcons.astro) from 50rem. */
	@media (min-width: 50rem) {
		.narrow-site-links {
			display: none;
		}
	}
	@media (max-width: 36rem) {
		.title-row :global(.site-title span) {
			display: none;
		}
	}
</style>
