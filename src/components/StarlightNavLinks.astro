---
// Replaces Starlight's social icons slot in the docs header: a link back to the landing page, then Starlight's own
// social icons (starlight-blog's RSS link). starlight-blog adds the Blog link itself.
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<nav class="site-links" aria-label="Site">
	<a href={`${base}/`}>Home</a>
</nav>
<Default />

<style>
	.site-links {
		display: flex;
		gap: 1rem;
	}
	a {
		color: var(--sl-color-text-accent);
		text-decoration: none;
		font-size: var(--sl-text-sm);
	}
	a:hover {
		color: var(--sl-color-white);
	}
</style>
