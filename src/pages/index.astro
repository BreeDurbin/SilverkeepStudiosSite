---
import { getCollection } from 'astro:content';
import { Code } from 'astro:components';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const sampleScript = `// Content/Angelscripts/Guard_OnHeartbeat.as
void OnHeartbeat(FEntityId Self)
{
    FCreatureData Guard =
        GetEntityApi().GetCreatureData(Self);

    GetScriptApi().LogInfo(
        Guard.Metadata.Name + " keeps watch.");
}`;

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const dateFormat = new Intl.DateTimeFormat('en', { dateStyle: 'long', timeZone: 'UTC' });
---

<BaseLayout description="Project Silverkeep is a fantasy role-playing game built on the 3.5 edition SRD rules, where the story emerges from your choices and you can build worlds of your own.">
	<section class="hero">
		<div class="container hero-inner">
			<p class="eyebrow">Silverkeep Studios</p>
			<h1>Project Silverkeep</h1>
			<p class="tagline">Project Silverkeep is a fantasy role-playing game built on the 3.5 edition SRD rules, where the story emerges from your choices and you can build worlds of your own.</p>
			<div class="hero-actions">
				<a class="button button-primary" href={`${base}/blog/`}>Read the devlog</a>
				<a class="button button-secondary" href={`${base}/docs/`}>Explore the docs</a>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container modding">
			<div>
				<h2 class="section-title">Modding Support</h2>
				<p>
					Game data lives in TOML files you can read and change. Creatures run scripts written in
					<a href="https://www.angelcode.com/angelscript/">AngelScript</a>, the open-source scripting
					language by Andreas Jönsson, and reach the game through Silverscript,
					Project Silverkeep's scripting API for AngelScript. Campaign modules
					and override folders let you layer your own content on top.
				</p>
				<p>
					The <a href={`${base}/docs/`}>documentation</a> covers the Silverscript API and every data format,
					generated straight from the game so it stays current.
				</p>
			</div>
			<div class="code-panel">
				<Code code={sampleScript} lang="cpp" theme="github-dark-dimmed" />
			</div>
		</div>
	</section>
	
	<section class="section">
    	<div class="container multiplayer">
    		<div>
    			<h2 class="section-title">Multiplayer Support</h2>
    			<p>
    				Project Silverkeep supports cooperative multiplayer
    				with player-hosted worlds. Host a game to play with your friends or setup your own persistent world server for a larger playerbase.
    			</p>
    			<p>
    				Whether you're running a private campaign with friends or building a
    				persistent world for a larger community, Silverkeep is designed to put
    				world ownership in the hands of its players.
    			</p>
    		</div>
    	</div>
    </section>

	{
		posts.length > 0 && (
			<section class="section">
				<div class="container">
					<h2 class="section-title">From the devlog</h2>
					<ul class="post-list">
						{posts.map((post) => (
							<li>
								<a href={`${base}/blog/${post.id}/`}>{post.data.title}</a>
								<p class="post-meta">
									<time datetime={post.data.pubDate.toISOString()}>{dateFormat.format(post.data.pubDate)}</time>
								</p>
								<p>{post.data.description}</p>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}
</BaseLayout>

<style>
	.hero {
		position: relative;
		padding: 5rem 0 3rem;
		background:
			radial-gradient(60rem 26rem at 50% -6rem, var(--glow), transparent 70%),
			linear-gradient(to bottom, var(--bg-raised), var(--bg));
		border-bottom: 1px solid var(--panel-border);
		text-align: center;
	}

	.hero-inner {
		max-width: 46rem;
	}

	.hero h1 {
		font-size: clamp(2.25rem, 7vw, 4rem);
		margin: 0 0 1rem;
	}

	.tagline {
		font-family: var(--font-display);
		font-size: clamp(1.05rem, 2.4vw, 1.35rem);
		color: var(--accent);
		margin: 0 0 1.25rem;
	}

	.hero-copy {
		color: var(--text);
		margin: 0 auto 2rem;
		max-width: 38rem;
	}

	.hero-actions {
		display: flex;
		gap: 0.75rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.feature {
		background: var(--panel);
		border: 1px solid var(--panel-border);
		border-top: 2px solid var(--accent);
		border-radius: 8px;
		padding: 1.25rem 1.35rem;
	}

	.feature h3 {
		font-size: 1.05rem;
		margin: 0 0 0.5rem;
	}

	.feature p {
		margin: 0;
		font-size: 0.97rem;
	}

	.modding {
		display: grid;
		gap: 2rem;
		align-items: center;
	}
	
	.multiplayer {
    	display: grid;
    	gap: 2rem;
    	align-items: center;
    }
    
    @media (min-width: 56rem) {
    	.multiplayer {
    		grid-template-columns: 1fr 1fr;
    	}
    }

	@media (min-width: 56rem) {
		.modding {
			grid-template-columns: 1fr 1fr;
		}
	}

	.code-panel {
		min-width: 0;
	}

	/* The sample uses a dark syntax theme, so its panel stays dark in both site themes. */
	.code-panel :global(pre) {
		background: #1d1f1d !important;
		border-color: #443326;
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.5rem;
	}

	.post-list a {
		font-family: var(--font-display);
		font-size: 1.2rem;
		text-decoration: none;
	}

	.post-list p {
		margin: 0.25rem 0 0;
	}
</style>
